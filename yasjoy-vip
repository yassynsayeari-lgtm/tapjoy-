<section id="loading" class="card">Connecting to your VIP account…</section>
<section id="notVip" class="card hidden"><h2>VIP access required</h2><p class="muted">This Firebase account has not been activated as a YASJOY VIP member. Contact YASJOY administration.</p><a href="index.html">Back to Main App</a></section>
<section id="vipContent" class="hidden">
 <div class="card hero"><div>VIP Account Number</div><div id="vipNumber" class="balance">—</div><div>Available VIP Points</div><div id="vipBalance" class="balance">0</div><div id="vipIpLine" class="muted" style="color:#effff4"></div></div>
 <div class="card"><h2>Withdraw Points</h2><p class="muted">Choose the points you want to withdraw. The value is calculated at 1,000 points = $1.00.</p><label class="field" for="withdrawPoints">Points to withdraw</label><input id="withdrawPoints" type="number" min="1" step="1" inputmode="numeric" placeholder="Example: 10000"><p class="muted">Estimated payment: <strong id="usdEstimate">$0.00</strong></p><button type="button" class="btn secondary" id="maxBtn">Use all available points</button><button type="button" id="requestBtn">Submit withdrawal request</button><p id="requestMsg" class="muted" aria-live="polite"></p></div>
 <div class="card"><h2>Withdrawals & Payment Invoices</h2><div id="withdrawalHistory"><p class="muted">No withdrawal requests yet.</p></div></div>
 <div class="card"><h2>Invoices</h2><div id="invoiceList"><p class="muted">No paid invoices yet.</p></div></div>
</section>
</main><footer><a href="index.html">Back to YASJOY</a> · YASJOY VIP</footer>
<script type="module">
import{initializeApp,getApps,getApp}from'https://www.gstatic.com/firebasejs/12.4.0/firebase-app.js';
import{getAuth,signInAnonymously,onAuthStateChanged}from'https://www.gstatic.com/firebasejs/12.4.0/firebase-auth.js';
import{getFirestore,doc,onSnapshot}from'https://www.gstatic.com/firebasejs/12.4.0/firebase-firestore.js';
const config={apiKey:'AIzaSyB45rvl6iTjsdiW3-Ka6jyqiFaJmrsUUwI',authDomain:'yasjoy.firebaseapp.com',projectId:'yasjoy',storageBucket:'yasjoy.firebasestorage.app',messagingSenderId:'967065409063',appId:'1:967065409063:web:4f7b882cc38f17ec8a2002'};
const app=getApps().length?getApp():initializeApp(config),auth=getAuth(app),db=getFirestore(app),$=id=>document.getElementById(id);let currentUser=null,lastData=null;
try{onSnapshot(doc(db,'settings','appTheme'),s=>{const t=s.exists()?s.data().theme:'classic';document.documentElement.setAttribute('data-theme',t)},()=>{})}catch(e){}
async function api(path,method='GET',body=null){if(!currentUser)throw new Error('Account is not connected.');const token=await currentUser.getIdToken(),bases=[''];if(location.hostname!=='tapjoy-elp.pages.dev')bases.push('https://tapjoy-elp.pages.dev');let last='';for(const base of bases){try{const o={method,headers:{authorization:'Bearer '+token}};if(body!==null){o.headers['content-type']='application/json';o.body=JSON.stringify(body)}const r=await fetch(base+path,o),j=await r.json().catch(()=>null);if(r.ok&&j&&j.ok)return j;last=j?.error||'HTTP '+r.status}catch(e){last=e.message}}throw new Error(last||'VIP server unavailable')}
const fmt=n=>Number(n||0).toLocaleString('en-US'),usd=n=>'$'+(Number(n||0)/1000).toFixed(2);
function render(){const d=lastData;if(!d||!d.vipEnabled){$('loading').classList.add('hidden');$('vipContent').classList.add('hidden');$('notVip').classList.remove('hidden');return}$('loading').classList.add('hidden');$('notVip').classList.add('hidden');$('vipContent').classList.remove('hidden');$('vipNumber').textContent=d.vipNumber||'VIP';$('vipBalance').textContent=fmt(d.balance);$('vipIpLine').textContent=d.ipAddress?'Registered IP: '+d.ipAddress:'No IP address registered yet';
 const inv=(d.invoices||[]),invMap=new Map(inv.map(x=>[x.id,x]));const history=$('withdrawalHistory');history.replaceChildren();const req=(d.withdrawals||[]).slice().sort((a,b)=>String(b.createdAt||'').localeCompare(String(a.createdAt||'')));if(!req.length)history.textContent='No withdrawal requests yet.';req.forEach(w=>{const c=document.createElement('div');c.className='history';const h=document.createElement('div');h.className='topline';const strong=document.createElement('strong');strong.textContent='Withdrawal '+w.id.slice(0,10);const badge=document.createElement('span');badge.className='tag '+(w.status==='paid'?'paid':'pending');badge.textContent=w.status==='paid'?'✓ Paid':'Pending';h.append(strong,badge);c.append(h);[['Points',fmt(w.points)],['Payment value',usd(w.points)],['IP address',w.ipAddress||'—']].forEach(([k,v])=>{const row=document.createElement('div');row.className='row';const a=document.createElement('span'),b=document.createElement('b');a.textContent=k;b.textContent=v;row.append(a,b);c.append(row)});const invoice=invMap.get(w.invoiceId);if(invoice){const box=document.createElement('div');box.className='invoice';const title=document.createElement('strong');title.textContent='✓ Payment received';const number=document.createElement('div');number.textContent='Invoice: '+(invoice.invoiceNumber||invoice.id);const amount=document.createElement('div');amount.textContent='Paid: '+usd(invoice.points);box.append(title,number,amount);c.append(box)}history.append(c)});
 const list=$('invoiceList');list.replaceChildren();if(!inv.length)list.textContent='No paid invoices yet.';inv.slice().sort((a,b)=>String(b.paidAt||'').localeCompare(String(a.paidAt||''))).forEach(v=>{const c=document.createElement('div');c.className='history';const tag=document.createElement('span');tag.className='tag paid';tag.textContent='✓ PAID';const strong=document.createElement('strong');strong.textContent=v.invoiceNumber||v.id;c.append(tag,strong);[['Points',fmt(v.points)],['Amount',usd(v.points)],['Paid at',v.paidAt?new Date(v.paidAt).toLocaleString():'—']].forEach(([k,val])=>{const row=document.createElement('div');row.className='row';const a=document.createElement('span'),b=document.createElement('b');a.textContent=k;b.textContent=val;row.append(a,b);c.append(row)});list.append(c)});
}
async function load(){try{lastData=await api('/api/vip/me');render()}catch(e){$('loading').textContent=e.message}}
onAuthStateChanged(auth,async user=>{try{if(!user){await signInAnonymously(auth);return}currentUser=user;await load()}catch(e){$('loading').textContent=e.message}});
window.addEventListener('focus',()=>{if(currentUser)load()});document.addEventListener('visibilitychange',()=>{if(document.visibilityState==='visible'&&currentUser)load()});setInterval(()=>{if(currentUser&&document.visibilityState==='visible')load()},30000);
function updateEstimate(){const p=Math.max(0,Number($('withdrawPoints').value)||0);$('usdEstimate').textContent=usd(p)}$('withdrawPoints').addEventListener('input',updateEstimate);$('maxBtn').onclick=()=>{if(lastData){$('withdrawPoints').value=Number(lastData.balance||0);updateEstimate()}};
$('requestBtn').onclick=async()=>{const points=Number($('withdrawPoints').value),b=$('requestBtn');if(!Number.isSafeInteger(points)||points<=0){$('requestMsg').textContent='Enter a whole number of points.';return}b.disabled=true;$('requestMsg').textContent='Submitting…';try{const d=await api('/api/vip/withdraw','POST',{points});$('requestMsg').textContent='Your request was submitted. Value: '+usd(d.points)+'.';$('withdrawPoints').value='';updateEstimate();await load()}catch(e){$('requestMsg').textContent=e.message}finally{b.disabled=false}};
</script></body></html>
